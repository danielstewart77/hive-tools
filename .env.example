# hive-tools configuration. Copy to .env and fill in real values.
#
# SECURITY: HT_SECRET_KEY and HT_ADMIN_PASSWORD have insecure fallback
# defaults in code ("change-this-in-production" / "changeme"). A deployment
# that leaves them unset seeds a known admin credential. Always set both.

# --- Core ---
HT_SECRET_KEY=generate-with-openssl-rand-hex-32  # secret-guard: allow
HT_ADMIN_PASSWORD=set-a-real-password  # secret-guard: allow
HT_DB_PATH=/app/data/hivetools.db
HIVE_LOG_LEVEL=INFO

# --- Host paths (consumed by docker-compose.yml) ---
HOST_DEV_DIR=/path/to/your/dev/root
HIVE_MIND_DIR=/path/to/your/hive_mind
HF_HOME=/path/to/your/.cache/huggingface

# --- Hive services ---
COMMS_URL=http://hive-comms:8426
COMMS_BEARER_TOKEN=
LUCENT_URL=http://hive-lucent:8425
LUCENT_ADMIN_BEARER_TOKEN=

# --- Ollama ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=gpt-oss:20b-32k
TRAINING_OLLAMA_URL=http://host.docker.internal:11434

# --- Telegram (notify tool) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# --- SMS gateway (android-sms-gateway, private-server mode) ---
SMS_GATEWAY_URL=http://sms-gateway:3000
SMS_GATEWAY_USER=
SMS_GATEWAY_PASS=
SMS_GATEWAY_PRIVATE_TOKEN=
SMS_GATEWAY_JWT_SECRET=
SMS_GATEWAY_DB_ROOT_PASSWORD=
SMS_GATEWAY_DB_PASSWORD=

# --- Google OAuth (gmail / calendar tools) ---
# Place client_secret.json in credentials/; tokens are written beside it.
